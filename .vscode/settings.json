{
    "cmake.cmakePath": "cube-cmake",
    "cmake.configureArgs": [
        "-DCMAKE_COMMAND=cube-cmake"
    ],
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "cmake.additionalCompilerSearchDirs": [
        "/usr/bin/",
        "/opt/homebrew/bin/"
    ],

    // INTELLISENSE CONFIGS
    
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc.exe",
        "--query-driver=${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++.exe"
    ],
    // clangd
    "clangd.path": "/usr/bin/clangd",                           //for linux and mac(vscode extension)
    "clangd.arguments":[
        "--query-driver=/usr/bin/arm-none-eabi-gcc",            //for linux
        "--query-driver=/opt/homebrew/bin/arm-none-eabi-gcc"    //for mac
    ]
}